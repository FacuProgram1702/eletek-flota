# ELETEK Gestión — variables de entorno
# Copiar como ".env" y completar. El .env NO se versiona.

# Puerto propio. El panel de conectividad (API MIKRO) sigue en el 3000.
PORT=3100

# Firma las cookies de sesión. Cualquier texto largo y al azar.
SESSION_SECRET=

# Usuario de ELETEK (superadministrador). Se crea solo en el primer arranque.
SUPER_USER=eletek
SUPER_PASS=

# Base de datos de este sistema
DB_PATH=data/gestion.db

# Base del panel de conectividad, SOLO LECTURA: de ahí sale la posición GPS
# de cada barco para los partes de pesca. Opcional.
CONECTIVIDAD_DB=../conectividad/data/eletek.db

# Dirección del panel de conectividad (acceso directo en el menú). Opcional.
CONECTIVIDAD_URL=https://panel.tu-dominio.com

# Contraseña de los usuarios de ejemplo que crea "npm run semilla"
SEMILLA_CLAVE=ejemplo2026

# DuckDNS: mantiene la IP del subdominio de este sistema (opcional)
DUCKDNS_TOKEN=
DUCKDNS_DOMINIOS=
