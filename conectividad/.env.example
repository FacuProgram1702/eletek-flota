# Panel de conectividad — variables de entorno
# Copiar como ".env" y completar. El .env NO se versiona.

PORT=3000

# Firma las cookies de sesión. Cualquier texto largo y al azar.
SESSION_SECRET=

# Administrador del panel (no se guarda en la base)
ADMIN_USER=admin
ADMIN_PASS=

# Base de datos
DB_PATH=data/eletek.db
